{
  "name": "bulsu-gwa-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BulSU GWA Calculator & Academic Honors Eligibility Checker (static site + Cloudflare Worker API/MCP)",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "lint:html": "html-validate index.html",
    "check:js": "node scripts/check-js.mjs",
    "test": "node tests/smoke.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:parity": "node tests/parity.mjs",
    "check": "npm run lint:html && npm run check:js && npm run test",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "html-validate": "^9.0.0",
    "playwright": "^1.48.0"
  },
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.33.0"
}
